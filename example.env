# =============================================================================
# Abyss - environment configuration
# =============================================================================
# Copy to `.env` and fill the required secrets: cp example.env .env
# `.env` is git-ignored. The backend loads it via python-dotenv; Vite loads it
# for `VITE_*` only. `VITE_*` values are baked at build time: rebuild after
# changing them. An empty value is not "unset": comment a line out to use the
# code default.
#
# Required for a first run: JWT_SECRET_KEY, ABYSS_ADMIN_PASSWD, PostgreSQL
# credentials, plus running PostgreSQL and Redis.
# =============================================================================


# --- Frontend (Vite) and public URLs ----------------------------------------

# Public frontend origin (scheme + host, no trailing slash). Used for CORS.
VITE_ABYSS_URL="http://localhost"
# Backend API base URL, reachable from the browser. It is embedded literally in
# the generated API client: rerun `npm run generate-models` after changing it.
VITE_ABYSS_API_URL="http://localhost:5555"
# Frontend dev port. The backend appends it to VITE_ABYSS_URL and switches JWT
# cookies to SameSite=Lax + Secure=false; comment out for production HTTPS
# (cookies become SameSite=None + Secure=true). Does not configure Vite itself.
VITE_PORT=5173
# Backend bind port (Gunicorn). Use the same port in VITE_ABYSS_API_URL locally.
VITE_FLASK_PORT=5555
# Build-time flag.
# 1 = static JSON snapshots in public/api (no API, login or uploads);
# 0 = live API.
VITE_FREEZE=0
# Max agent-name length, enforced by both UI and backend. Keep values identical.
VITE_AGENT_NAME_MAX_LENGTH=45


# --- Gunicorn / Flask HTTP server -------------------------------------------

# Worker processes; rule of thumb: 2 x CPU cores + 1, limited by RAM.
FLASK_WORKERS_NB=4
# Request-handling threads per worker.
FLASK_THREADS_NB=8
# Kill/restart a worker silent for this many seconds.
FLASK_TIMEOUT=60
# Grace period for in-flight requests on shutdown.
FLASK_GRACEFUL_TIMEOUT=30
# Recycle a worker after N requests (jitter up to 500 is added).
FLASK_MAX_REQUESTS=5000
# debug, info, warning, error or critical.
FLASK_LOG_LEVEL=info


# --- Administrator and authentication ---------------------------------------

# Admin account seeded on first start and reconciled on later starts; the admin
# group is only created if missing.
ABYSS_ADMIN_GROUP_NAME="Corail-lab"
ABYSS_ADMIN_NAME="CORAIL"
# REQUIRED. Empty is accepted by the code but gives an empty password.
ABYSS_ADMIN_PASSWD=""
# REQUIRED. Generate with:
#   python -c "import secrets; print(secrets.token_hex(64))"
# Empty is accepted but insecure; changing it invalidates all sessions.
JWT_SECRET_KEY=""
# Access-token lifetime, in hours.
JWT_ACCESS_TOKEN_EXPIRES=5
# Refresh-token lifetime, in days.
JWT_REFRESH_TOKEN_EXPIRES=30


# --- Arena defaults (applied at database seeding) ---------------------------

# Initial state: 0 = paused, 1 = running. Also editable from the admin panel.
DEFAULT_ARENA_STATE=0
# Initial parallel matches (code default 1). Only applied when the arena row is
# first created; change it later from the admin panel.
DEFAULT_MAX_PARALLEL_MATCH=5
# 1 = reset arena state to DEFAULT_ARENA_STATE on each start; 0 = keep DB state.
RESET_ARENA_ON_START=1
# PORT value passed to agent-verification containers.
ABYSS_VERIFIER_PORT=16000


# --- Redis ------------------------------------------------------------------

# Used for log pub/sub, JWT revocation, verifier queue and arena events.
REDIS_URL=redis://localhost:6379/0


# --- PostgreSQL -------------------------------------------------------------

# Database name, role and password. Create them before the first start. The
# password may be empty only with peer/trust authentication.
# The URL is built by concatenation: avoid @ : / % in user/password, or
# URL-encode them.
POSTGRE_DB_NAME="flask_db"
POSTGRE_DB_USER="flask_db"
POSTGRE_DB_PASSWD=""
POSTGRE_DB_HOST="localhost"
POSTGRE_DB_PORT=5432
# Max connections per engine = DB_POOL_SIZE + DB_MAX_OVERFLOW. Keep
# workers x that total below PostgreSQL's max_connections.
DB_POOL_SIZE=8
DB_MAX_OVERFLOW=4
# Seconds to wait for a free connection.
DB_POOL_TIMEOUT=30
# Recycle pooled connections after N seconds.
DB_POOL_RECYCLE=1800


# --- Optional developer tooling ---------------------------------------------

# Override the Swagger URL used by `npm run generate-models`.
# Default: ${VITE_ABYSS_API_URL}/swagger.json
# ABYSS_SWAGGER_URL="http://localhost:5555/swagger.json"


# --- Reserved variables (no effect with the current code) -------------------

# DB_SETUP_TIMEOUT is read by run.py but not passed to the migration command.
# DB_SETUP_TIMEOUT=600

# Arena containers currently hardcode mem_limit 9g (matches) / 5g (verify),
# network "bridge", and ports from 16001. ABYSS_VERIFIER_PORT above is wired.
# MAX_MEMORY_MATCH="8g"
# MATCHES_NETWORK="bridge"
# MATCHES_FIRST_PORT=16001
